# EdgeTinker: settings for a DEVELOPMENT computer.
# Copy to ".env" and run "php artisan key:generate".
# For the live server use .env.production.example instead.

APP_NAME=EdgeTinker
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL is required (product search uses FULLTEXT indexes).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edgetinker
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Emails and image resizing run on the database queue.
# Locally, run "php artisan queue:work" (or "composer dev") to process them.
QUEUE_CONNECTION=database
CACHE_STORE=database

# "log" writes emails to storage/logs/laravel.log instead of sending them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@edgetinker.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where contact-form messages are emailed (can also be set in Content Studio → Site settings).
CONTACT_RECIPIENT=

VITE_APP_NAME="${APP_NAME}"
