# EdgeTinker: settings for the LIVE server (Hostinger).
# Copy to ".env" on the server and fill in every value marked CHANGE-ME.
# Never commit the real .env file. See docs/DEPLOYMENT.md.

APP_NAME=EdgeTinker
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=CHANGE-ME
# Must stay false on the live site: true would show error details to visitors.
APP_DEBUG=false
# Your real address, with https and no trailing slash. Image links are built from this.
APP_URL=https://edgetinker.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# From hPanel → Databases → Management.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE-ME
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies are only ever sent over HTTPS, and not with requests from other sites.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Database queue, run by the cron job (schedule:run every minute).
QUEUE_CONNECTION=database
# The file cache needs no extra service and is fast on shared hosting.
CACHE_STORE=file

# A mailbox created in hPanel → Emails.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@edgetinker.com
MAIL_PASSWORD=CHANGE-ME
# Must be the same mailbox as MAIL_USERNAME, or the mail server may refuse to send.
MAIL_FROM_ADDRESS="no-reply@edgetinker.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where contact-form messages are emailed (can also be set in Content Studio → Site settings).
CONTACT_RECIPIENT=CHANGE-ME

# Only if the site sits behind a proxy or CDN (for example Cloudflare): "*" or a
# comma-separated list of the proxy's IP addresses. Leave empty otherwise.
TRUSTED_PROXIES=

# Only if the storage symlink cannot be created (see docs/DEPLOYMENT.md, step 7):
# the full path of a "storage" folder inside the web root.
# PUBLIC_DISK_ROOT=/home/uXXXXXXXXX/domains/edgetinker.com/public_html/storage

VITE_APP_NAME="${APP_NAME}"
